# ==============================================================================
# Fizyobar Platform - Çevre Değişkenleri (Environment Configuration)
# ==============================================================================

# Uygulama Ayarları
APP_NAME="Fizyobar"
APP_ENV=local                       # local | production | staging
APP_DEBUG=true                      # true (geliştirme), false (canlı)
APP_KEY=fizyobar_sec_9f48a1c97a224a1b8c2dfa9e71b2670e
APP_TIMEZONE="Europe/Istanbul"
APP_DEFAULT_LANG=tr                 # tr | en
APP_FALLBACK_LANG=en

# URL ve Dizin Ayarları (Localde ve Canlıda otomatik uyum sağlar)
# Boş bırakılırsa sistem mevcut host ve path'ten otomatik tespit eder.
APP_URL=http://localhost/fizyobar
CANONICAL_DOMAIN=localhost

# Veritabanı Ayarları (Local / XAMPP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fizyobar_db
DB_USERNAME=root
DB_PASSWORD=""
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Canlı Sunucu Veritabanı Yedeği (Gerektiğinde canlıya aktarırken burası kullanılır)
PROD_DB_HOST=localhost
PROD_DB_PORT=3306
PROD_DB_DATABASE=fizyobar_prod
PROD_DB_USERNAME=fizyobar_user
PROD_DB_PASSWORD="YourStrongPasswordHere"

# Oturum ve Çerez Güvenliği
SESSION_NAME=fizyo_session
SESSION_LIFETIME=7200               # Saniye cinsinden (2 saat)
COOKIE_SECURE=auto                  # auto (HTTPS varsa aktif), true (zorunlu), false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Lax                 # Lax | Strict | None

# Güvenlik ve Rate Limiting
SECURITY_RATE_LIMIT=120             # Dakika başına istek sınırı
SECURITY_RATE_WINDOW=60             # Saniye
SECURITY_BLOCK_UNKNOWN_USER_AGENTS=false

# Görsel & WebP Optimizasyonu
WEBP_AUTO_CONVERT=true
WEBP_QUALITY=82
IMAGE_CACHE_DAYS=30

