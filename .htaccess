# ==============================================================================
# Fizyobar Platform - Apache Security, Caching & Routing Rules (.htaccess)
# ==============================================================================

# 1. TEMEL SUNUCU AYARLARI
# ------------------------------------------------------------------------------
# Dizin listelemeyi engelle
Options -Indexes -MultiViews

# Takip sembolik linkler
Options +FollowSymLinks

# Varsayılan karakter seti
AddDefaultCharset UTF-8

# Server imzasını gizle (desteklenen sunucularda)
ServerSignature Off

# 2. HASSAS DOSYA VE KLASÖRLERİN ERİŞİMİNİ ENGELLEME
# ------------------------------------------------------------------------------
# .env, .git, .md, .sql, .log ve yedekleme dosyalarına doğrudan erişimi engelle
<FilesMatch "^\.|\.(env.*|git.*|sql|md|log|sh|bak|json|lock|dist|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. GÜVENLİK BAŞLIKLARI (SECURITY HEADERS)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # X-Frame-Options: Clickjacking saldırılarına karşı koruma
    Header always set X-Frame-Options "SAMEORIGIN"

    # X-Content-Type-Options: MIME sniffing engelleme
    Header always set X-Content-Type-Options "nosniff"

    # X-XSS-Protection: Eski tarayıcılar için ek koruma katmanı
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer-Policy: Referans gizliliği
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions-Policy: Donanım ve tarayıcı izinlerini kısıtla
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # X-Powered-By ve Server başlıklarını kaldır
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # Content-Security-Policy: Temel ve esnek CSP kuralları
    Header set Content-Security-Policy "default-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' https: data:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:;"

    # HSTS (Sadece HTTPS bağlantılarda geçerlidir)
    <If "%{HTTPS} == 'on'">
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    </If>
</IfModule>

# 4. GZIP / DEFLATE SIKIŞTIRMA (HIZ & PERFORMANS OPTİMİZASYONU)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/truetype
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>

# 5. TARAYICI ÖNBELLEKLEME (BROWSER CACHING)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML
    ExpiresByType text/html "access plus 0 seconds"

    # Veriler
    ExpiresByType text/xml "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"

    # Medya ve Görseller (WebP, PNG, JPG, SVG)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fontlar
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# 6. URL YÖNLENDİRME & ROUTING (MOD_REWRITE)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canlı sunucu için HTTP -> HTTPS otomatik yönlendirme (Localhost ve yerel IP hariç)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Hassas klasörlere doğrudan web erişimini 403 Forbidden ile kesin olarak engelle
    RewriteRule ^(config|core|app|storage|languages)(/.*)?$ - [F,L]

    # Eğer istek doğrudan var olan bir dosya veya dizinse (örn: assets), dokunma
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tüm diğer temiz URL isteklerini front controller index.php'ye yönlendir
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>
