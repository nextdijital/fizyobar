# ==============================================================================
# Fizyobar Platform - Örnek Çevre Dosyası (.env.example)
# Canlıya alırken .env oluşturup bu şablonu doldurunuz.
# ==============================================================================

APP_NAME="Fizyobar"
APP_ENV=production
APP_DEBUG=false
APP_KEY=generate_a_random_32_char_secure_key
APP_TIMEZONE="Europe/Istanbul"
APP_DEFAULT_LANG=tr
APP_FALLBACK_LANG=en

APP_URL=https://fizyobar.com
CANONICAL_DOMAIN=fizyobar.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fizyobar_prod
DB_USERNAME=fizyobar_user
DB_PASSWORD=""
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_NAME=fizyo_session
SESSION_LIFETIME=7200
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Lax

SECURITY_RATE_LIMIT=120
SECURITY_RATE_WINDOW=60

WEBP_AUTO_CONVERT=true
WEBP_QUALITY=82
IMAGE_CACHE_DAYS=30

